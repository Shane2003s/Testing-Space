<template id="template" xml:space="preserve">

    <t t-name="Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension" owl="1">
        <xpath expr="//img[hasclass('pos-logo')]" position="replace">
            <t t-if="get_logo()">
                <img style="width: max-content;height: 40px;" t-on-click="() => debug.toggleWidget()" t-att-src="get_logo()" />
            </t>
            <t t-else="">
                <img class="pos-logo h-75 ms-3 me-auto align-self-center" t-on-click="() => debug.toggleWidget()" src="/web/static/img/logo.png" alt="odoo Logo" />
            </t>
        </xpath>
    </t>
</template>
