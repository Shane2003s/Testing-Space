<template id="template" xml:space="preserve">
    <t t-name="ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//img[hasclass('pos-receipt-logo')]" position="replace">
            <t t-if="props.data.show_logo_on_receipt and props.data.pos_logo_base_64">
                <img t-att-src="props.data.pos_logo_base_64" class="pos-receipt-logo w-25 mx-auto align-self-center" alt="Logo" />
            </t>
            <t t-else="">
                <img t-attf-src="/web/image?model=res.company&amp;id={{props.data.company.id}}&amp;field=logo" alt="Logo" class="pos-receipt-logo"/>
            </t>
        </xpath>
    </t>
</template>
