<odoo>
    <record id="view_pos_config_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_clear_cart</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='restaurant_section']" position="before">
                <block>
                    <field name="pos_pos_logo" id="pos_pos_logo" widget="image" />
                </block>
            </xpath>
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">
                <setting id="pos_show_logo_on_recipt" string="Show Logo on Receipt" help="Print Pos logo on the receipt">
                    <field name="pos_show_logo_on_receipt" />
                </setting>

            </xpath>
        </field>
    </record>
</odoo>
